# ────────────────────────────────────────────────────────────────
# TeamFlow environment example — copy to .env (repo root) or
# server/.env and fill in real values. Never commit real secrets.
# ────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma + the pg driver adapter.
# Local development (Prisma Dev / PGLite):  npm run db:local
DATABASE_URL="postgres://postgres:postgres@localhost:51214/teamflow?sslmode=disable"

# Secrets — generate with:  openssl rand -base64 48
JWT_SECRET="replace-me-access-token-secret"
JWT_REFRESH_SECRET="replace-me-refresh-token-secret"

# HTTP
PORT=4000
NODE_ENV=development

# Origin of the web client (CORS allow-list + links in emails/notifications)
CLIENT_URL="http://localhost:5173"

# Access / refresh token lifetimes (ms). Defaults shown.
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000

# Socket.IO
SOCKET_CORS_ORIGIN="http://localhost:5173"

# Optional: absolute max upload/attachment link length guard
MAX_UPLOAD_MB=10

# Optional: override bcrypt cost factor (default 12 in prod, 10 in dev/test)
BCRYPT_ROUNDS=10
